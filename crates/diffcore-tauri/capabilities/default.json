{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://**" }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
